+
+static void
+kk_sparse_update_residency_texture(
+   struct kk_queue *queue, const struct kk_image *image, mtl_heap *heap,
+   const struct mtl_sparse_texture_mapping *mappings, uint32_t count)
+{
+   mtl_texture *texture = image->planes[0].mtl_handle_residency;
+   const struct kk_image_sparse *sparse = &image->sparse;
+   struct mtl_sparse_texture_mapping batch[64];
+   uint32_t n = 0u;
+
+   if (texture == NULL)
+      return;
+
+   for (uint32_t i = 0u; i < count; ++i) {
+      struct mtl_sparse_texture_mapping m = mappings[i];
+      if (m.level == sparse->mtl_tail_level) {
+         if (m.origin.x >= sparse->residency_tail_pages)
+            continue;
+         m.size.x = MIN2(m.size.x, sparse->residency_tail_pages - m.origin.x);
+      }
+      batch[n++] = m;
+      if (n == ARRAY_SIZE(batch)) {
+         kk_sparse_update_texture(queue, texture, heap, batch, n);
+         n = 0u;
+      }
+   }
+   if (n)
+      kk_sparse_update_texture(queue, texture, heap, batch, n);
 }
 
